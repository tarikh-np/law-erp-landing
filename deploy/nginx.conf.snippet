# ============================================================================
# Tarikh — nginx configuration snippet
#
# Drop into a server block set, then reload nginx. Replace /var/www/tarikh with
# the real document root, and fill in the TLS certificate paths.
#
# Goal: http -> https, apex -> www, old flat paths -> clean URLs, and a real
# 404 status, each in a single hop.
# ============================================================================

# 1. Plain HTTP on either host -> the canonical https://www host.
server {
    listen      80;
    listen      [::]:80;
    server_name tarikh.tech www.tarikh.tech;

    # ACME challenges must stay on http.
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }

    return 301 https://www.tarikh.tech$request_uri;
}

# 2. HTTPS on the apex -> the canonical www host.
server {
    listen              443 ssl;
    listen              [::]:443 ssl;
    http2               on;
    server_name         tarikh.tech;

    ssl_certificate     /etc/letsencrypt/live/tarikh.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tarikh.tech/privkey.pem;

    return 301 https://www.tarikh.tech$request_uri;
}

# 3. The canonical site.
server {
    listen              443 ssl;
    listen              [::]:443 ssl;
    http2               on;
    server_name         www.tarikh.tech;

    ssl_certificate     /etc/letsencrypt/live/tarikh.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tarikh.tech/privkey.pem;

    root  /var/www/tarikh;
    index index.html;

    charset utf-8;

    # ---------------------------------------------------------- 404 status
    error_page 404 /404.html;
    location = /404.html {
        internal;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    # ------------------------------------------------- old paths -> clean URLs
    # One 301 hop each. Do not leave these 404ing and do not let them serve a
    # second copy of the page.
    location = /index.html                                { return 301 https://www.tarikh.tech/; }
    location = /features.html                             { return 301 https://www.tarikh.tech/features; }
    location = /pricing.html                              { return 301 https://www.tarikh.tech/pricing; }
    location = /privacy.html                              { return 301 https://www.tarikh.tech/privacy; }
    location = /terms.html                                { return 301 https://www.tarikh.tech/terms; }
    location = /blog/index.html                           { return 301 https://www.tarikh.tech/blog/; }
    location = /blog/blog-post-nepal-court-hierarchy.html { return 301 https://www.tarikh.tech/blog/nepal-court-hierarchy; }

    # ---------------------------------------------------------- routing
    # `$uri/index.html` is tested first so a folder route such as /features
    # serves features/index.html directly, with no external redirect and no
    # trailing-slash hop that would contradict the canonical tag.
    location = / {
        try_files /index.html =404;
    }

    location / {
        try_files $uri/index.html $uri =404;
    }

    # ---------------------------------------------------------- headers
    add_header X-Content-Type-Options  "nosniff" always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy      "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()" always;
    add_header X-Frame-Options         "SAMEORIGIN" always;
    # HSTS: enable only once HTTPS is confirmed on both hosts.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # ---------------------------------------------------------- caching
    # CSS and JS filenames carry a content hash (see deploy/minify.py), and
    # /assets images and fonts are referenced by content, so immutable is safe.
    location ~* ^/(assets|css|js)/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~* \.(html|xml|txt|webmanifest)$ {
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    # ---------------------------------------------------------- compression
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_comp_level   6;
    gzip_types        text/plain text/css text/xml application/xml application/json
                      application/ld+json application/javascript application/manifest+json
                      image/svg+xml;
}
