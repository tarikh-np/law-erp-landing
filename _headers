# Tarikh — headers for Netlify and Cloudflare Pages.
# Later blocks win, so the asset rules below override the catch-all.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=0, must-revalidate
# HSTS: enable only once HTTPS is confirmed on both the apex and www, and you are
# ready to commit to it. Ships commented out on purpose.
# Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Filenames for CSS and JS carry a content hash (see deploy/minify.py) and images
# and fonts are referenced by their content, so immutable is safe on these paths.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# HTML, the sitemap and the manifest are revalidated on every request.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
